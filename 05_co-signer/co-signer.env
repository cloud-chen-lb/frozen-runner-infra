
# 示例值：51A10C6E-9927-437C-8867-F951176C435B
PAIRING_TOKEN="3F8CBB14-A2B3-4BB8-954A-E71034433F05"

CONFIG_MODE="LOCAL_FILE"

# 数据库配置
# 提示：测试期间，使用 start 命令时，添加 --enable-mysql 参数，则无需配置以下三项： MYSQL_URL、MYSQL_USER 和 MYSQL_PASSWORD。
MYSQL_URL=
MYSQL_USER=
MYSQL_PASSWORD=

# KMS 配置
KMS_TYPE="GCPKMS"
# 示例值：lig****t5
GOOGLE_PROJECT="echox-beta"
# 同 scripts/02_create-cloud-kms.sh 裡面的 KMS_LOCATION
GOOGLE_REGION="asia-east1"
# 同 scripts/02_create-cloud-kms.sh 裡面的 KMS_KEYRING
GOOGLE_KEYRING="fr-safeheron-apicosigner-keyring"
# 同 scripts/02_create-cloud-kms.sh 裡面的 KMS_CRYPTO_KEY
GOOGLE_CRYPTO_KEY="fr-safeheron-apicosigner-key"

# Callback 协议版本
CALLBACK_VERSION="v3"